# Twenty instance — auto-injected in deployed apps; required for local dev
TWENTY_API_URL=http://localhost:3000
TWENTY_APP_ACCESS_TOKEN=your_api_key_here

# Email sending via SMTP (nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_SECURE=false

# Sender address
EMAIL_FROM=digest@your-domain.com
EMAIL_FROM_NAME=Twenty CRM

# Digest behaviour
LOOKBACK_HOURS=24
SKIP_EMPTY_DIGESTS=true
